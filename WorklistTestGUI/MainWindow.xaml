<Window x:Class="WorklistTestGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorklistTestGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="250" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="4" FontSize="20" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 0 0 30">
            是否在结算后将此处方中的影像检查<LineBreak/>提交到影像设备工作列表？
        </TextBlock>
        <Button Content="是" Grid.Column="1" Grid.Row="1" FontSize="20" Height="50" Margin="0 0 20 0" VerticalAlignment="Top" Click="Yes_Click"/>
        <Button Content="否" Grid.Column="2" Grid.Row="1" FontSize="20" Height="50" Margin="20 0 0 0" VerticalAlignment="Top" Click="No_Click"/>
    </Grid>
</Window>
