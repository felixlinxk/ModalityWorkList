<Window x:Class="WorklistTestGUI.Summit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorklistTestGUI"
        mc:Ignorable="d"
        Title="Summit" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Border Background="#F0F0F0" CornerRadius="20" Margin="10" Grid.RowSpan="3" Grid.ColumnSpan="3">
            <GroupBox Header="病例信息" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"  Margin="5" BorderThickness="0" FontSize="15">
                <Grid Name="PatientInfoPara" DataContext="{Binding Path=StudyQuery}" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Border Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="10" Background="#ffffff" Margin="5"/>
                    <Border Grid.Column="2" Grid.ColumnSpan="2" CornerRadius="10" Background="#ffffff" Margin="5"/>
                    <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="10" Background="#ffffff" Margin="5"/>
                    <Border Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="10" Background="#ffffff" Margin="5"/>
                    <Border Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" CornerRadius="10" Background="#ffffff" Margin="5"/>
                    <Border Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="2" CornerRadius="10" Background="#ffffff" Margin="5"/>
                    <Border Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" CornerRadius="10" Background="#ffffff" Margin="5"/>
                    <Border Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="2" CornerRadius="10" Background="#ffffff" Margin="5"/>
                    <Border Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" CornerRadius="10" Background="#ffffff" Margin="5"/>
                    <Border Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="2" CornerRadius="10" Background="#ffffff" Margin="5"/>
                    <Border Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="4" CornerRadius="10" Background="#ffffff" Margin="5"/>
                    <TextBlock Text="姓名：*" Grid.Column="0" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    <TextBox Name="InputName" Text="喵喵" Grid.Column="1" Grid.Row="0" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"/>
                    <TextBlock Text="病历号：*" Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    <TextBox Name="InputID" Text="123456789" Grid.Column="3" Grid.Row="0" Margin="2.5" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"/>
                    <TextBlock Text="检查号：*" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    <TextBox Name="InputAccessionNumber" Text="2022070801" Grid.Column="1" Grid.Row="1" Margin="2.5" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"/>
                    <TextBlock Text="检查描述：" Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    <TextBox Name="InputDescription"  Grid.Column="3" Grid.Row="1" Margin="2.5" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"/>
                    <TextBlock Text="动物生日：" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    <TextBox Name="InputPatientBirthday" Text="20200701" Grid.Column="1" Grid.Row="2" Margin="2.5" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"/>
                    <TextBlock Text="体重：" Grid.Column="2" Grid.Row="2" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    <TextBox Name="InputPatientWeight" Text="10.24" Grid.Column="3" Grid.Row="2" Margin="2.5" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"/>
                    <TextBlock Text="性别：" Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    <TextBox Name="InputPatientSex" Text="M" Grid.Column="1" Grid.Row="3" Margin="2.5" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"/>
                    <TextBlock Text="处方医生：" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    <TextBox Name="InputReferringPhysicianName" Text="林贤康" Grid.Column="3" Grid.Row="3" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"/>
                    <TextBlock Text="检查医生：" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    <TextBox Name="InputOperatorsName" Grid.Column="1" Grid.Row="4" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"/>
                    <TextBlock Text="判读医生：" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    <TextBox Name="InputNameOfPhysiciansReadingStudy" Grid.Column="3" Grid.Row="4" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"/>
                    <TextBlock Text="病史备注：" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    <TextBox Name="InputHistory" Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="3" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"/>


                </Grid>
            </GroupBox>
        </Border>

        <GroupBox Grid.Column="3" Grid.Row="0" Grid.RowSpan="1" Header="预约日期" Margin="5" FontSize="15">
            <Grid Name="DatePara" Margin="5 0 5 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <RadioButton Name="OtherDate" Content="特定日期" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Center" FontSize="13" Click="Date_Click"/>
                <DatePicker Name="DatePicker" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" FontSize="13" SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                <RadioButton Name="Tomorrow" Content="明天" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" FontSize="13" Click="Date_Click"/>
                <RadioButton Name="TodayPlus2" Content="后天" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" FontSize="13" Click="Date_Click"/>
                <RadioButton Name="Today" Content="今天" Grid.Column="0" Grid.Row="0" IsChecked="True" VerticalAlignment="Center" FontSize="13" Click="Date_Click"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Column="3" Grid.Row="1" Grid.RowSpan="1" Header="预约时间" Margin="5" FontSize="15">
            <Grid Name="TimePara" Margin="5 0 5 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <RadioButton Name="Now" Content="现在" IsChecked="True" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" FontSize="13"/>
                <RadioButton Name="OneHourLater" Content="1小时后" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Center" FontSize="13"/>
                <RadioButton Name="OtherTime" Content="其他" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1" Height="25">
                    <TextBox x:Name="ScheduleTime_Hour" Width="30" HorizontalContentAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text=" 时 " VerticalAlignment="Center"/>
                    <TextBox x:Name="ScheduleTime_Min" Width="30" HorizontalContentAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text=" 分 " VerticalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="3" Grid.Row="2" Header="影像设备" Grid.ColumnSpan="1" Grid.RowSpan="1" Margin="5" FontSize="15">
            <Grid Name="ModalitiesSelection" Margin="15 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <CheckBox Name="DX" Content="DX" IsChecked="false" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Click="Modalities_Check"/>
                <CheckBox Name="CR" Content="CR" IsChecked="false" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontSize="13" Click="Modalities_Check"/>
                <CheckBox Name="US" Content="US" IsChecked="false" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="13" Click="Modalities_Check"/>
                <CheckBox Name="MR" Content="MR" IsChecked="true" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Click="Modalities_Check"/>
                <CheckBox Name="CT" Content="CT" IsChecked="false" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="13" Click="Modalities_Check"/>
            </Grid>
        </GroupBox>

        <Button Content="提交" Grid.Column="1" Grid.Row="3" Margin="10 10 20 10" Click="Summit_Click" />
        <Button Content="取消" Grid.Column="2" Grid.Row="3" Margin="20 10 10 10" Click="Cancel_Click"/>
    </Grid>
</Window>
